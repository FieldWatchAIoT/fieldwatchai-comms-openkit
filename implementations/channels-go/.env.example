# Copy to .env for local dev. Never commit real secrets.

# HTTP
PORT=9090
LOG_LEVEL=info
ENV=dev
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=262144

# Database — matches this repo's docker-compose (Postgres 16 + PostGIS on 5434).
DATABASE_URL=postgres://openkit:openkit@localhost:5434/openkit?sslmode=disable

# Internal auth (shared with the comms-webhook — MUST match webhook's
# INTERNAL_API_TOKEN so /v1/ingest calls authenticate).
INTERNAL_API_TOKEN=local-token

# Per-account credential encryption.
#   localaes — AES-256-GCM with a static key from LOCAL_AES_KEY (dev/CI only)
#   kms      — AWS KMS envelope encryption (prod)
CREDENTIALS_ENCRYPTION=localaes

# base64 of a 32-byte key; generate: head -c32 /dev/urandom | base64
LOCAL_AES_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Used only when CREDENTIALS_ENCRYPTION=kms
CREDENTIALS_KMS_KEY_ID=

AWS_REGION=us-west-2
