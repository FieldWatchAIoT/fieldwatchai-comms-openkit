# comms-openkit webhook — environment template
# Copy to .env for local dev. Never commit real secret values.

# --- server ---
PORT=8080
ENV=dev
LOG_LEVEL=info
MAX_BODY_BYTES=262144          # 256 KB inbound body cap
SHUTDOWN_TIMEOUT=10s

# --- forwarding to your downstream "channels" service ---
# When running docker-compose the bundled fakechannels stub answers here.
CHANNELS_URL=http://localhost:9090
INTERNAL_API_TOKEN=

# --- durable queue (leave empty for in-memory / local dev) ---
AWS_REGION=us-west-2
SQS_QUEUE_URL=
SQS_DLQ_URL=

# --- UltraMSG WhatsApp listener ---
# Shared secret you control; UltraMSG sends it back as ?token=... on the webhook
# URL (UltraMSG does not sign requests). Verified in constant time; never logged.
WHATSAPP_ULTRAMSG_WEBHOOK_SECRET=

# Account map: platform -> { platform-identifier -> account_id }.
# For UltraMSG, the identifier is your instance id.
ACCOUNTS_MAP={"whatsapp-ultramsg":{"<instanceId>":"acc_replace_me"}}

# --- Twilio listener (opt-in: registered only when the auth token is set) ---
# One auth token verifies both whatsapp-twilio and sms-twilio. PUBLIC_BASE_URL
# is the public origin Twilio signs against (behind the ALB) — required with
# Twilio.
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=

# --- Telegram listener (opt-in: registered only when the secret is set) ---
# The secret_token set on setWebhook; verified against the
# X-Telegram-Bot-Api-Secret-Token header. The bot token itself lives in your
# downstream sender service, not here.
TELEGRAM_WEBHOOK_SECRET=

# --- Email (AWS SES) listener (opt-in: registered only when the secret is set) ---
# SES -> SNS -> HTTPS subscription -> /inbound/email-ses?token=<secret>. SNS
# cannot add custom headers, so the secret rides in the subscription URL
# (constant-time compared). EMAIL_SES_TOPIC_ARN is the allowlist — only this
# topic may post; required when the secret is set.
EMAIL_SES_WEBHOOK_SECRET=
EMAIL_SES_TOPIC_ARN=
